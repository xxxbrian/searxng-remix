{
  "name": "searxng-remix",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.28.12",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local node_modules/srvx/bin/srvx.mjs --prod -s ../client dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/solid-query": "^5.107.1",
    "@tanstack/solid-router": "^1.170.43",
    "@tanstack/solid-start": "^1.169.5",
    "solid-js": "^1.9.18",
    "srvx": "^1.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}
