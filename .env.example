# Copy to .env.local (ignored by git) and fill in. Process environment variables win.

# SearXNG instance with the JSON format enabled (see docker/searxng/settings.yml).
SEARXNG_URL=http://localhost:8888

# Enables /admin. At least 12 characters. Also encrypts API keys saved in the admin.
ADMIN_PASSWORD=

# Settings, history, encrypted keys and the usage log.
DATA_DIR=./data

# AI summaries: any OpenAI-compatible provider. Off until a key and a model are set.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# Intent detection: any service that speaks the System One decision API.
# Defaults to TypeSafe's Jev. Point JEV_BASE_URL at the same host as AI_BASE_URL
# (for example a gateway that serves both) to reuse AI_API_KEY.
JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai/v1
# JEV_MODEL=jev-latest
